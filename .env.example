# Внешний IP, который браузер пользователя увидит для WebRTC.
# Локально (Docker Desktop): 127.0.0.1. На сервере: его публичный IP.
PUBLIC_IP=127.0.0.1

# Домен для HTTPS (должен указывать на PUBLIC_IP). Без своего домена подойдёт <IP>.sslip.io.
# :80 — без HTTPS (локальный запуск).
DOMAIN=:80

# Внешние порты HTTP и HTTPS
HTTP_PORT=80
HTTPS_PORT=443

# Пароли комнат neko (поменяйте!)
USER_PASSWORD=neko
ADMIN_PASSWORD=admin

# Разрешение и FPS виртуального экрана. Меньше = легче канал до Африки.
SCREEN=1280x720@30

# Стартовая вкладка удалённого браузера
START_URL=https://alice.yandex.ru/

# Порт видеопотока WebRTC (tcp+udp). Поменяйте, если рядом запущен другой стек neko.
WEBRTC_PORT=52000
